# Copy to .env and fill in. .env is git- and docker-ignored: it is never
# committed and never baked into the image — the container reads it through
# docker-compose env_file.

# --- core ---
PORT=3001
NODE_ENV=production
API_MONGO_URI=mongodb://mongo:27017/teadb
JWT_SECRET=
ALLOWED_CORS=https://teaform.ru
FRONTEND_URL=https://teaform.ru

# --- password reset e-mail (optional; the link is logged when SMTP_HOST is unset) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- VK ID sign-in (optional; the buttons are inert without these) ---
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=https://teaform.ru/api/auth/vk/callback

# --- Yandex Cloud: voice notes and form extraction (optional) ---
# Without these, voice notes still record, merge and play back — only the
# transcription and the field extraction are skipped.
# The service account needs role ai.speechkit-stt.user for recognition and
# ai.languageModels.user for YandexGPT.
YC_API_KEY=
YC_FOLDER_ID=
# Only if YandexGPT lives under a different service account or folder than
# SpeechKit; otherwise leave blank and the two above are used for both.
YC_GPT_API_KEY=
YC_GPT_FOLDER_ID=
